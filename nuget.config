<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Feed GHCR do Fcg.Contracts. O owner do GitHub nao e segredo (consta na URL publica do
         repo e no nuspec do pacote). Sem <packageSourceCredentials> porque o token nunca e
         commitado: entra em runtime (GITHUB_TOKEN do runner no CI / PAT read:packages no build
         local). O feed NuGet do GitHub Packages exige token mesmo para package publico. -->
        <add key="github-fcg" value="https://nuget.pkg.github.com/reinaldogez/index.json" />
    </packageSources>
</configuration>
