<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Feed GHCR publico do Fcg.Contracts. OWNER e placeholder: o usuario/org do GitHub
         e resolvido na montagem fisica dos repos (Fase 3); restore e anonimo (feed publico),
         por isso sem <packageSourceCredentials>. O pacote so e referenciado em T07. -->
        <add key="github-fcg" value="https://nuget.pkg.github.com/OWNER/index.json" />
    </packageSources>
</configuration>
